rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function stringBetween(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validExercise(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','description','createdAt'])
        && d.keys().hasOnly(['id','name','description','createdAt'])
        && d.id == id && id.matches('^[a-f0-9]{64}$')
        && stringBetween(d.name, 80) && stringBetween(d.description, 600)
        && d.createdAt is number && d.createdAt > 0;
    }
    function validWorkout(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','rest','exercises','updatedAt','archived'])
        && d.keys().hasOnly(['id','name','rest','exercises','updatedAt','archived'])
        && d.id == id && stringBetween(d.name, 60)
        && d.rest is number && d.rest >= 0 && d.rest <= 600
        && d.exercises is list && d.exercises.size() > 0 && d.exercises.size() <= 30
        && d.updatedAt is number && d.updatedAt > 0 && d.archived is bool;
    }
    function validSession(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','workoutName','rest','startedAt','completedAt','exercises'])
        && d.keys().hasOnly(['id','workoutName','rest','startedAt','completedAt','exercises','program'])
        && (!('program' in d) || validProgramSession(d.program))
        && d.id == id && stringBetween(d.workoutName, 60)
        && d.rest is number && d.rest >= 0 && d.rest <= 600
        && d.startedAt is number && d.startedAt > 0
        && d.completedAt is number && d.completedAt >= d.startedAt
        && d.exercises is list && d.exercises.size() > 0 && d.exercises.size() <= 30;
    }
    function programTemplate(id) {
      return id in ['foundation-3','strength-size-4','barbell-strength-4']
        || (id is string && id.matches('^custom-[a-zA-Z0-9-]{1,128}$'));
    }
    function validProgramSession(p) {
      return p is map && p.keys().hasAll(['enrollmentId','templateId','week','day','countsForProgress'])
        && p.keys().hasOnly(['enrollmentId','templateId','week','day','countsForProgress'])
        && p.enrollmentId is string && p.enrollmentId.matches('^[a-zA-Z0-9-]{1,128}$')
        && programTemplate(p.templateId)
        && p.week is int && p.week >= 1 && p.week <= (p.templateId == 'foundation-3' ? 8 : (p.templateId.matches('^custom-.*$') ? 52 : 12))
        && p.day is int && p.day >= 1 && p.day <= (p.templateId == 'foundation-3' ? 3 : (p.templateId.matches('^custom-.*$') ? 7 : 4))
        && p.countsForProgress is bool;
    }
    function validCustomProgram(custom) {
      return custom is map
        && custom.keys().hasAll(['name','weeks','estimatedMinutes','sessions'])
        && custom.keys().hasOnly(['name','weeks','estimatedMinutes','sessions'])
        && stringBetween(custom.name, 60)
        && custom.weeks is int && custom.weeks >= 1 && custom.weeks <= 52
        && stringBetween(custom.estimatedMinutes, 20)
        && custom.sessions is list && custom.sessions.size() > 0 && custom.sessions.size() <= 7;
    }
    function validProgram(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','templateId','version','startedAt','updatedAt','archived'])
        && d.keys().hasOnly(['id','templateId','version','startedAt','updatedAt','archived','deleted','custom'])
        && d.id == id && id.matches('^[a-zA-Z0-9-]{1,128}$') && programTemplate(d.templateId)
        && (d.templateId.matches('^custom-.*$') ? ('custom' in d && validCustomProgram(d.custom)) : !('custom' in d))
        && d.version == 1 && d.startedAt is number && d.startedAt > 0
        && d.updatedAt is number && d.updatedAt >= d.startedAt && d.archived is bool
        && (!('deleted' in d) || d.deleted is bool);
    }
    match /users/{uid}/programs/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validProgram(id);
      allow delete: if false;
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validExercise(id);
      // Library entries are shared and immutable: no user can rewrite someone else's description.
      allow update, delete: if false;
    }
    match /users/{uid}/workouts/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validWorkout(id);
      allow delete: if false;
    }
    match /users/{uid}/sessions/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSession(id);
      // Idempotent retries are allowed; completed training history cannot be overwritten.
      allow update: if owner(uid) && request.resource.data == resource.data;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
